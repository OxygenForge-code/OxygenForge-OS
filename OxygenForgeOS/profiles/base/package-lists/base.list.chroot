# OxygenForgeOS common packages
# Keep this list small and explicit; every additional package enlarges the ISO
# and expands the attack surface.

bash
bash-completion
ca-certificates
console-setup
coreutils
cryptsetup
curl
dbus
debian-archive-keyring
dosfstools
e2fsprogs
efibootmgr
file
fonts-dejavu-core
fonts-noto-core
git
gnupg
gdisk
htop
iproute2
iw
keyboard-configuration
less
locales
man-db
manpages
mtools
nano
nftables
openssh-client
openssl
os-prober
parted
pciutils
pkexec
polkitd
procps
python3
python3-gi
gir1.2-gtk-3.0
rfkill
rsync
sudo
systemd-resolved
systemd-timesyncd
tmux
tzdata
unzip
usbutils
vim-tiny
wget
xdg-utils
xz-utils
zstd

# Hardware support. Firmware is local to the image; it does not phone home.
firmware-atheros
firmware-iwlwifi
firmware-linux
firmware-realtek
